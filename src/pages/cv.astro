---
// Static (non-variable) Inter: variable fonts are embedded as Type3 in Chrome PDFs, which many ATS can't read.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import { Image } from 'astro:assets';
import { getResume, img, range, fmtDate, SITE } from '../lib/data';
import { plainText } from '../lib/plain-text';

const resume = await getResume();
const b = resume.basics;
const avatar = img(b.image);
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
// Profile URLs are written out in full: an ATS only keeps the text, not the link target.
const contacts = ['LinkedIn', 'GitHub']
  .map((n) => b.profiles.find((p) => p.network === n))
  .filter((p) => p !== undefined);

// Main roles get full detail; internships and part-time roles are listed in one line each.
const mainRoles = resume.work.filter((w) => w.type === 'Full-time' || w.type === 'Freelance');
const earlierRoles = resume.work.filter((w) => !mainRoles.includes(w));
const projects = resume.projects.filter((p) => p.onCv);
const activities = resume.activities.slice(0, 3);
const feedback = resume.testimonials.filter((t) => t.onCv);
const yearOf = (d: string) => d.slice(0, 4);
const plain = plainText;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{b.name} | CV</title>
<meta name="description" content={`Two-page CV of ${b.name}, ${b.label}: experience, selected projects, skills and certificates.`}>
<link rel="canonical" href={`${SITE}/cv/`}>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="alternate" type="application/json" href="/resume.json" title="JSON Resume">
<meta name="color-scheme" content="light">
<style is:global>
/* An editorial, ink-on-paper layout: hierarchy comes from type and hairline rules, not from
   boxes, pills or colour. The accent is kept for links. */
@page{size:A4;margin:11mm 12mm 13mm}
:root{--ink:#1b1c1f;--body:#2d2f34;--muted:#62666f;--rule:#d8d8d4;--accent:#1f4f8f}
*{box-sizing:border-box;margin:0;padding:0}
body{font:9.5pt/1.45 Inter,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--body);background:#ecebe7;-webkit-print-color-adjust:exact;print-color-adjust:exact;font-feature-settings:'liga' 0,'clig' 0;font-variant-ligatures:none}
a{color:inherit;text-decoration:none}
ul{list-style:none}

.bar{max-width:210mm;margin:20px auto 0;display:flex;gap:8px;justify-content:flex-end;padding:0 4px}
.bar a{font:600 13px Inter,sans-serif;padding:9px 14px;border-radius:8px;border:1px solid #cfcdc6;background:#fff;color:var(--ink)}
.bar .p{background:var(--ink);color:#fff;border-color:var(--ink)}
.sheet{max-width:210mm;margin:12px auto 40px;background:#fff;padding:13mm 13mm 14mm;box-shadow:0 1px 2px rgba(0,0,0,.08),0 12px 32px -18px rgba(0,0,0,.25)}

/* header */
header{display:grid;grid-template-columns:auto 1fr;gap:5.5mm;align-items:end;padding-bottom:4.5mm;border-bottom:.5pt solid var(--ink)}
header img{width:21mm;height:21mm;border-radius:1.5mm;object-fit:cover}
h1{font-size:25pt;font-weight:700;line-height:1;letter-spacing:-.025em;color:var(--ink)}
.role{font-size:11pt;font-weight:500;color:var(--ink);margin:1.6mm 0 1.6mm}
.contact{display:flex;flex-wrap:wrap;gap:.4mm 0;margin-top:.6mm;font-size:8.5pt;color:var(--muted)}
.contact span:not(:last-child)::after{content:'\00b7';margin:0 2mm;color:#a3a6ad}
.contact a{color:var(--ink)}

.impact{display:grid;grid-template-columns:repeat(4,1fr);margin:3.6mm 0 0;padding-bottom:3.4mm;border-bottom:.5pt solid var(--rule)}
.impact div{padding:0 3.5mm;border-left:.5pt solid var(--rule)}
.impact div:first-child{padding-left:0;border-left:0}
.impact b{display:block;font-size:12pt;font-weight:700;line-height:1.15;color:var(--ink);letter-spacing:-.01em}
.impact span{font-size:7.8pt;color:var(--muted);line-height:1.3;display:block;margin-top:.5mm}

.cols{display:grid;grid-template-columns:1fr 52mm;gap:8mm;margin-top:1mm}

h2{font-size:9.6pt;font-weight:700;color:var(--ink);letter-spacing:.01em;margin:4.4mm 0 1.8mm}
.summary{color:var(--body)}

.job{margin-bottom:3.2mm;break-inside:avoid}
.earlier-block{break-inside:auto}
.earlier li{break-inside:avoid}
.job-h,.proj-h{display:flex;justify-content:space-between;gap:3mm;align-items:baseline}
.job h3,.proj h3{font-size:10pt;font-weight:600;color:var(--ink)}
.job h3 .org{font-weight:400}
.when{font-size:8.3pt;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.meta{font-size:8.3pt;color:var(--muted);margin:.1mm 0 .8mm}
.job ul,.proj ul{margin-top:.8mm}
.job li,.proj li{list-style:'\2013\00a0\00a0' outside;margin-left:3.2mm}
.job li::marker,.proj li::marker{color:var(--muted)}
.job li+li{margin-top:.3mm}

.earlier-title{font-size:9.4pt;font-weight:600;color:var(--ink);margin-bottom:.8mm}
.earlier li{padding:.25mm 0}
.earlier b{font-weight:500;color:var(--ink)}
.earlier span{color:var(--muted)}

.proj{margin-bottom:2.8mm;break-inside:avoid}
.kind{font-size:8.3pt;color:var(--muted);white-space:nowrap}
.tech{font-size:8.2pt;color:var(--muted);margin-top:.4mm}
.tech a{color:var(--accent);text-decoration:underline;text-decoration-thickness:.5pt;text-underline-offset:.5mm}

.fb{margin:0 0 2.6mm;padding-left:3.2mm;border-left:.5pt solid var(--ink);break-inside:avoid}
.fb blockquote{color:var(--body);line-height:1.42}
.fb figcaption{font-size:8.2pt;color:var(--muted);margin-top:.6mm}
.act{margin-bottom:1.8mm;break-inside:avoid}
.act b{font-weight:600;color:var(--ink)}
.act p{color:var(--muted);font-size:8.6pt}

aside section{break-inside:avoid}
aside h2{margin-top:4.4mm}
.sk{margin-bottom:1.8mm}
.sk b{display:block;font-size:8.6pt;font-weight:600;color:var(--ink)}
.sk p{font-size:8.6pt;color:var(--body);line-height:1.4}
.edu b{display:block;font-weight:600;color:var(--ink)}
.edu p,.small{font-size:8.6pt;color:var(--muted)}
.plain{font-size:8.6pt;line-height:1.5;color:var(--body)}
.cert{margin-bottom:1.4mm;font-size:8.6pt;line-height:1.32}
.cert b{font-weight:600;display:block;color:var(--ink)}
.cert span{color:var(--muted)}
.lang{display:flex;justify-content:space-between;font-size:8.6pt;padding:.2mm 0}
.lang b{font-weight:500;color:var(--ink)}
.lang span{color:var(--muted)}

@media print{
  body{background:#fff}
  .bar{display:none}
  .sheet{margin:0;padding:0;box-shadow:none;max-width:none}
}
@media screen{
  .contact a,.tech a{display:inline-block;min-height:24px;line-height:24px}
}
@media (max-width:760px){
  .sheet{padding:20px}
  header{grid-template-columns:1fr}
  .impact{grid-template-columns:1fr 1fr;row-gap:3mm}
  .impact div:nth-child(3){padding-left:0;border-left:0}
  .cols{grid-template-columns:1fr}
}
</style>
</head>
<body>
<nav class="bar" aria-label="CV actions">
  <a href="/">← Portfolio</a>
  <a href="/resume.json" download="usama-fouad-resume.json">JSON</a>
  <a class="p" href="/cv.pdf" download="Usama-Fouad-CV.pdf">Download PDF</a>
</nav>
<main class="sheet">
  <header>
    {avatar && <Image src={avatar} alt={b.name} width={180} height={180} loading="eager" />}
    <div>
      <h1>{b.name}</h1>
      <div class="role">{b.label}, working in Swift, SwiftUI and UIKit</div>
      <div class="contact">
        <span>{b.location.city}, Egypt</span>
        {b.phone && <span><a href={`tel:${b.phone.replace(/\s/g, '')}`}>{b.phone}</a></span>}
        <span><a href={`mailto:${b.email}`}>{b.email}</a></span>
        {b.availability && <span>{b.availability}</span>}
      </div>
      <div class="contact">
        <span><a href={b.url}>{host(b.url)}</a></span>
        {contacts.map((p) => <span><a href={p.url}>{host(p.url)}</a></span>)}
      </div>
    </div>
  </header>

  <div class="impact">
    {resume.stats.map((s) => <div><b>{plain(s.value)}</b><span>{plain(s.label)}</span></div>)}
  </div>

  <div class="cols">
    <div>
      <section>
        <h2>Summary</h2>
        <p class="summary">{plain(b.summary)}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {mainRoles.map((w) => (
          <div class="job">
            <div class="job-h"><h3>{w.position} · <span class="org">{w.name}</span></h3><span class="when">{range(w.startDate, w.endDate)}</span></div>
            <div class="meta">{[w.type, w.location].filter(Boolean).join(' · ')}</div>
            <p>{w.summary}</p>
            {w.highlights.length > 0 && <ul>{w.highlights.slice(0, 3).map((h) => <li>{plain(h)}</li>)}</ul>}
          </div>
        ))}
        {earlierRoles.length > 0 && (
          <div class="job earlier-block">
            <h3 class="earlier-title">Earlier experience</h3>
            <ul class="earlier">
              {earlierRoles.map((w) => <li><b>{w.position}</b>, {w.name} <span>({w.type}, {yearOf(w.startDate)})</span></li>)}
            </ul>
          </div>
        )}
      </section>

      <section>
        <h2>Projects</h2>
        {projects.map((p) => (
          <div class="proj">
            <div class="proj-h"><h3>{p.name}</h3><span class="kind">{p.private ? 'Client work' : 'Open source'}{p.period && `, ${fmtDate(p.period)}`}</span></div>
            <p>{plain(p.description)}</p>
            {p.private && p.highlights.length > 0 && <ul>{p.highlights.slice(0, 1).map((h) => <li>{plain(h)}</li>)}</ul>}
            <div class="tech">{plain([p.at, ...p.keywords].filter(Boolean).join(' · '))}{p.url && <> · <a href={p.url}>{host(p.url)}</a></>}</div>
          </div>
        ))}
      </section>

      {feedback.length > 0 && (
        <section>
          <h2>Client feedback</h2>
          {feedback.map((t) => (
            <figure class="fb">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>— {[t.author, t.context, t.date.slice(0, 4), t.rating > 0 ? `rated ${t.rating}/5` : ''].filter(Boolean).join(', ')}</figcaption>
            </figure>
          ))}
        </section>
      )}

      <section>
        <h2>Activities</h2>
        {activities.map((a) => <div class="act"><b>{a.name}</b> <span class="small">· {a.role}{a.date && `, ${fmtDate(a.date)}`}</span><p>{a.description}</p></div>)}
      </section>
    </div>

    <aside>
      <section>
        <h2>Skills</h2>
        {resume.skills.map((s) => <div class="sk"><b>{s.name}</b><p>{s.keywords.join(', ')}</p></div>)}
      </section>
      <section>
        <h2>Strengths</h2>
        <p class="plain">{resume.softSkills.map((s) => s.name).join(', ')}</p>
      </section>
      <section>
        <h2>Education</h2>
        {resume.education.map((e) => <div class="edu"><b>{e.institution}</b><p>{e.studyType}{e.area && `, ${e.area}`}</p><p>{range(e.startDate, e.endDate)}</p></div>)}
      </section>
      {resume.awards.length > 0 && (
        <section>
          <h2>Awards</h2>
          {resume.awards.map((a) => <div class="cert"><b>{a.title}</b><span>{a.awarder}{a.summary && ` · ${a.summary}`}</span></div>)}
        </section>
      )}
      <section>
        <h2>Certifications</h2>
        {resume.certificates.map((c) => <div class="cert"><b>{c.name}</b><span>{c.issuer}{c.date && ` · ${yearOf(c.date)}`}</span></div>)}
      </section>
      {resume.volunteer.length > 0 && (
        <section>
          <h2>Volunteering</h2>
          {resume.volunteer.map((v) => <div class="cert"><b>{v.organization}</b><span>{v.position} · {range(v.startDate, v.endDate)}</span></div>)}
        </section>
      )}
      <section>
        <h2>Languages</h2>
        {resume.languages.map((l) => <div class="lang"><b>{l.language}</b><span>{l.fluency}</span></div>)}
      </section>
      <section>
        <h2>Interests</h2>
        <p class="small">{resume.interests.map((i) => i.name).join(' · ')}</p>
      </section>
    </aside>
  </div>
</main>
</body>
</html>
