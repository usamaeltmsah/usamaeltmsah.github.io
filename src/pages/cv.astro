---
import { Image } from 'astro:assets';
import { resume, img, range, fmtDate, SITE } from '../lib/data';

const b = resume.basics;
const avatar = img(b.image);
const show = ['GitHub', 'LinkedIn', 'Upwork'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{b.name} | CV</title>
<meta name="description" content={`Curriculum vitae of ${b.name}, ${b.label}.`}>
<link rel="canonical" href={`${SITE}/cv/`}>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="alternate" type="application/json" href="/resume.json" title="JSON Resume">
<meta name="color-scheme" content="light">
<style is:global>
@page{size:A4;margin:14mm 14mm}
*{box-sizing:border-box;margin:0}
body{font:10.5pt/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;color:#16181d;background:#eceef2}
a{color:#0a55c8;text-decoration:none}
.bar{max-width:210mm;margin:20px auto 0;display:flex;gap:10px;justify-content:flex-end;padding:0 4px}
.bar a,.bar button{font:600 14px inherit;font-family:inherit;padding:9px 14px;border-radius:10px;border:1px solid #d5d8de;background:#fff;color:#16181d;cursor:pointer}
.bar .p{background:#0a55c8;color:#fff;border-color:#0a55c8}
.page{max-width:210mm;margin:12px auto 40px;background:#fff;padding:16mm 15mm;box-shadow:0 10px 40px -20px rgba(0,0,0,.3)}
header{display:flex;gap:18px;align-items:center;padding-bottom:12px;border-bottom:2px solid #16181d}
header img{width:72px;height:72px;border-radius:50%;object-fit:cover}
h1{font-size:24pt;letter-spacing:-.02em;line-height:1.1}
.role{font-size:12.5pt;color:#0a55c8;font-weight:600}
.contact{display:flex;flex-wrap:wrap;gap:3px 14px;font-size:9.5pt;color:#444;margin-top:5px}
.cols{display:grid;grid-template-columns:1fr 62mm;gap:9mm;margin-top:12px}
h2{font-size:10pt;text-transform:uppercase;letter-spacing:.12em;color:#0a55c8;margin:14px 0 6px;padding-bottom:3px;border-bottom:1px solid #e3e5ea}
section:first-child h2{margin-top:0}
.item{margin-bottom:9px;break-inside:avoid}
.item h3{font-size:10.5pt;display:flex;justify-content:space-between;gap:8px}
.item h3 span{font-weight:400;color:#666;font-size:9.5pt;white-space:nowrap}
.org{color:#444;font-weight:600;font-size:10pt}
.item p,.item li{color:#333}
ul{padding-left:15px}
.tags{display:flex;flex-wrap:wrap;gap:4px}
.tag{font-size:8.8pt;padding:1px 7px;border-radius:99px;background:#eef2fb;color:#0a3f94}
aside p{color:#333;font-size:9.8pt}
aside .item{margin-bottom:7px}
.summary{color:#333}
.item p a{text-decoration:underline;text-underline-offset:2px}
@media print{body{background:#fff}.bar{display:none}.page{margin:0;padding:0;box-shadow:none;max-width:none}}
@media (max-width:700px){.page{padding:22px}.cols{grid-template-columns:1fr}header{flex-wrap:wrap}}
</style>
</head>
<body>
<div class="bar">
  <a href="/">← Portfolio</a>
  <a href="/resume.json" download="usama-fouad-resume.json">JSON</a>
  <a class="p" href="/cv.pdf" download="Usama-Fouad-CV.pdf">Download PDF</a>
</div>
<main class="page">
  <header>
    {avatar && <Image src={avatar} alt={b.name} width={144} height={144} loading="eager" />}
    <div>
      <h1>{b.name}</h1>
      <div class="role">{b.label}</div>
      <div class="contact">
        <span>{b.location.city}, Egypt</span>
        <a href={`mailto:${b.email}`}>{b.email}</a>
        <a href={b.url}>{b.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
        {b.profiles.filter((p) => show.includes(p.network)).map((p) => <a href={p.url}>{p.network}: {p.username}</a>)}
      </div>
    </div>
  </header>

  <div class="cols">
    <div>
      <section><h2>Profile</h2><p class="summary">{b.summary}</p></section>
      <section>
        <h2>Experience</h2>
        {resume.work.map((w) => (
          <div class="item">
            <h3>{w.position}<span>{range(w.startDate, w.endDate)}</span></h3>
            <div class="org">{w.name}{w.location && ` · ${w.location}`}</div>
            <p>{w.summary}</p>
            {w.highlights.length > 0 && <ul>{w.highlights.map((h) => <li>{h}</li>)}</ul>}
          </div>
        ))}
      </section>
      <section>
        <h2>Selected projects</h2>
        {resume.projects.filter((p) => p.featured).map((p) => (
          <div class="item"><h3>{p.name}<span>{p.keywords.join(' · ')}</span></h3><p>{p.description} <a href={p.url}>{p.url.replace('https://', '')}</a></p></div>
        ))}
      </section>
      {(resume.volunteer as any[]).length > 0 && (
        <section><h2>Volunteering</h2>
          {(resume.volunteer as any[]).map((v) => <div class="item"><h3>{v.position}<span>{range(v.startDate, v.endDate)}</span></h3><div class="org">{v.organization}</div><p>{v.summary}</p>{v.highlights?.length > 0 && <ul>{v.highlights.map((h: string) => <li>{h}</li>)}</ul>}</div>)}
        </section>
      )}
      <section>
        <h2>Activities</h2>
        {resume.activities.map((a) => <div class="item"><h3>{a.name}<span>{fmtDate(a.date)}</span></h3><p>{a.description}</p></div>)}
      </section>
    </div>

    <aside>
      <section>
        <h2>Education</h2>
        {resume.education.map((e) => <div class="item"><h3>{e.institution}</h3><p>{e.studyType}</p><p>{range(e.startDate, e.endDate)}</p></div>)}
      </section>
      <section>
        <h2>Skills</h2>
        {resume.skills.map((s) => <div class="item"><p><b>{s.name}</b></p><div class="tags">{s.keywords.map((k) => <span class="tag">{k}</span>)}</div></div>)}
      </section>
      <section>
        <h2>Soft skills</h2>
        <div class="tags">{resume.softSkills.map((s) => <span class="tag">{s.name}</span>)}</div>
      </section>
      {(resume.awards.length > 0 || (resume.certificates as any[]).length > 0) && (
        <section><h2>Awards & certificates</h2>
          {resume.awards.map((a) => <div class="item"><p><b>{a.title}</b>, {a.awarder}{a.date && ` (${a.date})`}</p></div>)}
          {resume.certificates.map((c) => <div class="item"><p><b>{c.name}</b><br>{c.issuer}{c.date && `, ${fmtDate(c.date)}`}</p></div>)}
        </section>
      )}
      <section>
        <h2>Languages</h2>
        {resume.languages.map((l) => <p>{l.language}: {l.fluency}</p>)}
      </section>
      <section>
        <h2>Interests</h2>
        <p>{resume.interests.map((i) => i.name).join(', ')}</p>
      </section>
    </aside>
  </div>
</main>
</body>
</html>
