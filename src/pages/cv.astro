---
// Static (non-variable) Inter: variable fonts are embedded as Type3 in Chrome PDFs, which many ATS can't read.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import { getResume, range, fmtDate, SITE } from '../lib/data';
import { plainText } from '../lib/plain-text';

const resume = await getResume();
const b = resume.basics;
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
// Profile URLs are written out in full: an ATS only keeps the text, not the link target.
const contacts = ['LinkedIn', 'GitHub']
  .map((n) => b.profiles.find((p) => p.network === n))
  .filter((p) => p !== undefined);

// Main roles get full detail; internships and part-time roles are listed in one line each.
const mainRoles = resume.work.filter((w) => w.type === 'Full-time' || w.type === 'Freelance');
const earlierRoles = resume.work.filter((w) => !mainRoles.includes(w));
const projects = resume.projects.filter((p) => p.onCv);
const activities = resume.activities.slice(0, 2);
const yearOf = (d: string) => d.slice(0, 4);
const plain = plainText;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Chrome writes the title into the PDF's metadata, which some ATS show as the file's name. -->
<title>{b.name}, {b.label}, CV</title>
<meta name="description" content={`Two-page CV of ${b.name}, ${b.label}: experience, selected projects, skills and certificates.`}>
<meta name="author" content={b.name}>
<link rel="canonical" href={`${SITE}/cv/`}>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="alternate" type="application/json" href="/resume.json" title="JSON Resume">
<meta name="color-scheme" content="light">
<style is:global>
/* One column, standard headings, no photo, icons, tables or text boxes: the layout resume
   screeners parse most reliably. Hierarchy comes from type and hairline rules. */
@page{size:A4;margin:11mm 14mm 12mm}
:root{--ink:#16171a;--body:#2b2d32;--muted:#5f636c;--rule:#d6d6d2;--accent:#1f4f8f}
*{box-sizing:border-box;margin:0;padding:0}
body{font:9.4pt/1.4 Inter,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--body);background:#ecebe7;-webkit-print-color-adjust:exact;print-color-adjust:exact;font-feature-settings:'liga' 0,'clig' 0;font-variant-ligatures:none}
a{color:inherit;text-decoration:none}
ul{list-style:none}

.bar{max-width:210mm;margin:20px auto 0;display:flex;gap:8px;justify-content:flex-end;padding:0 4px}
.bar a{font:600 13px Inter,sans-serif;padding:9px 14px;border-radius:8px;border:1px solid #cfcdc6;background:#fff;color:var(--ink)}
.bar .p{background:var(--ink);color:#fff;border-color:var(--ink)}
.sheet{max-width:210mm;margin:12px auto 40px;background:#fff;padding:14mm 15mm 15mm;box-shadow:0 1px 2px rgba(0,0,0,.08),0 12px 32px -18px rgba(0,0,0,.25)}

header{padding-bottom:3.6mm;border-bottom:.6pt solid var(--ink)}
h1{font-size:24pt;font-weight:700;line-height:1;letter-spacing:-.025em;color:var(--ink)}
.role{font-size:11.5pt;font-weight:500;color:var(--ink);margin:1.6mm 0 1.8mm}
.contact{display:flex;flex-wrap:wrap;font-size:8.8pt;color:var(--body)}
.contact+.contact{margin-top:.4mm}
.contact span:not(:last-child)::after{content:'|';margin:0 2.2mm;color:#b4b6bb}

h2{font-size:10.5pt;font-weight:700;color:var(--ink);text-transform:uppercase;margin:4mm 0 1.8mm;padding-bottom:.9mm;border-bottom:.5pt solid var(--rule)}
.summary{color:var(--body)}

.skills{display:grid;grid-template-columns:auto 1fr;gap:.7mm 4mm}
.skills dt{font-weight:600;color:var(--ink);white-space:nowrap}
.skills dd{margin:0}

.item{margin-bottom:2.6mm;break-inside:avoid}
.item-h{display:flex;justify-content:space-between;gap:4mm;align-items:baseline}
.item h3{font-size:10.2pt;font-weight:600;color:var(--ink)}
.item h3 .org{font-weight:400}
.when{font-size:8.8pt;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.meta{font-size:8.6pt;color:var(--muted);margin:.2mm 0 .8mm}
.item ul{margin-top:.8mm}
.item li{list-style:disc outside;margin-left:4mm;padding-left:.6mm}
.item li::marker{color:var(--muted);font-size:.85em}
.item li+li{margin-top:.3mm}
.tech{font-size:8.6pt;color:var(--muted);margin-top:.5mm}
.tech a{color:var(--accent);text-decoration:underline;text-decoration-thickness:.5pt;text-underline-offset:.5mm}

.lines li{break-inside:avoid;padding:.2mm 0}
.lines b{font-weight:600;color:var(--ink)}
.lines span{color:var(--muted)}
.earlier{margin-top:-.6mm}
.earlier h3{font-size:9.8pt;font-weight:600;color:var(--ink);margin-bottom:.6mm}

@media print{
  body{background:#fff}
  .bar{display:none}
  .sheet{margin:0;padding:0;box-shadow:none;max-width:none}
}
@media screen{
  .contact a,.tech a{display:inline-block;min-height:24px;line-height:24px}
}
@media screen and (max-width:760px){
  .sheet{padding:20px}
  .skills{grid-template-columns:1fr}
  .skills dd{margin-bottom:1.4mm}
  .item-h{flex-wrap:wrap;gap:0 4mm}
}
</style>
</head>
<body>
<nav class="bar" aria-label="CV actions">
  <a href="/">← Portfolio</a>
  <a href="/resume.json" download="usama-fouad-resume.json">JSON</a>
  <a class="p" href="/cv.pdf" download="Usama-Fouad-CV.pdf">Download PDF</a>
</nav>
<main class="sheet">
  <header>
    <h1>{b.name}</h1>
    <div class="role">{b.label} | Swift, SwiftUI, UIKit</div>
    <div class="contact">
      <span>{b.location.city}, Egypt</span>
      {b.phone && <span><a href={`tel:${b.phone.replace(/\s/g, '')}`}>{b.phone}</a></span>}
      <span><a href={`mailto:${b.email}`}>{b.email}</a></span>
      <span><a href={b.url}>{host(b.url)}</a></span>
    </div>
    <div class="contact">
      {contacts.map((p) => <span><a href={p.url}>{host(p.url)}</a></span>)}
    </div>
  </header>

  <section>
    <h2>Summary</h2>
    <p class="summary">{plain(b.summary)}</p>
  </section>

  <section>
    <h2>Skills</h2>
    <dl class="skills">
      {resume.skills.map((s) => <><dt>{s.name}</dt><dd>{s.keywords.join(', ')}</dd></>)}
    </dl>
  </section>

  <section>
    <h2>Experience</h2>
    {mainRoles.map((w) => (
      <div class="item">
        <div class="item-h"><h3>{w.position} · <span class="org">{w.name}</span></h3><span class="when">{range(w.startDate, w.endDate)}</span></div>
        <div class="meta">{[w.type, w.location].filter(Boolean).join(' · ')}</div>
        <p>{w.summary}</p>
        {w.highlights.length > 0 && <ul>{w.highlights.slice(0, 3).map((h) => <li>{plain(h)}</li>)}</ul>}
      </div>
    ))}
    {earlierRoles.length > 0 && (
      <div class="item earlier">
        <h3>Earlier experience</h3>
        <ul class="lines">
          {earlierRoles.map((w) => <li><b>{w.position}</b>, {w.name} <span>({w.type}, {yearOf(w.startDate)})</span></li>)}
        </ul>
      </div>
    )}
  </section>

  <section>
    <h2>Projects</h2>
    {projects.map((p) => (
      <div class="item">
        <div class="item-h"><h3>{p.name}</h3><span class="when">{p.private ? 'Client work' : 'Open source'}{p.period && `, ${fmtDate(p.period)}`}</span></div>
        <p>{plain(p.description)}</p>
        {p.private && p.highlights.length > 0 && <ul>{p.highlights.slice(0, 1).map((h) => <li>{plain(h)}</li>)}</ul>}
        <div class="tech">{plain([p.at, ...p.keywords].filter(Boolean).join(' · '))}{p.url && <> · <a href={p.url}>{host(p.url)}</a></>}</div>
      </div>
    ))}
  </section>

  <section>
    <h2>Education</h2>
    {resume.education.map((e) => (
      <div class="item">
        <div class="item-h"><h3>{e.studyType}{e.area && `, ${e.area}`}</h3><span class="when">{range(e.startDate, e.endDate)}</span></div>
        <p>{e.institution}</p>
      </div>
    ))}
  </section>

  <section>
    <h2>Certifications</h2>
    <ul class="lines">
      {resume.certificates.map((c) => <li><b>{c.name}</b>, {c.issuer}{c.date && <span> ({yearOf(c.date)})</span>}</li>)}
    </ul>
  </section>

  {resume.awards.length > 0 && (
    <section>
      <h2>Awards</h2>
      <ul class="lines">{resume.awards.map((a) => <li><b>{a.title}</b>, {a.awarder}{a.summary && <span>: {a.summary}</span>}</li>)}</ul>
    </section>
  )}

  <section>
    <h2>Activities and volunteering</h2>
    <ul class="lines">
      {activities.map((a) => <li><b>{a.name}</b>, {a.role}{a.date && <span> ({fmtDate(a.date)})</span>}</li>)}
      {resume.volunteer.map((v) => <li><b>{v.position}</b>, {v.organization} <span>({range(v.startDate, v.endDate)})</span></li>)}
    </ul>
  </section>

  <section>
    <h2>Languages</h2>
    <p>{resume.languages.map((l) => `${l.language} (${l.fluency})`).join(', ')}</p>
  </section>
</main>
</body>
</html>
