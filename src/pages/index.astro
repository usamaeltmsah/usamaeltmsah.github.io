---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getResume, img, range, fmtDate, github, posts, profileLink } from '../lib/data';
import { buildTimeline } from '../lib/timeline';

const resume = await getResume();
const profile = (network: string) => profileLink(resume, network);

const b = resume.basics;
const gh = await github();
const feed = await posts();
const avatar = img(b.image);
const featured = resume.projects.filter((p) => p.featured);
const clientWork = resume.projects.filter((p) => !p.featured && p.private);
const sideProjects = resume.projects.filter((p) => !p.featured && !p.private);
const heroShots = featured.map((p) => img(p.image)).filter(Boolean).slice(0, 3) as ImageMetadata[];
const current = resume.work[0];
const tech = [...new Set(resume.skills.flatMap((s) => s.keywords))];
const langColors: Record<string, string> = { Swift: '#F05138', Ruby: '#CC342D', Python: '#3572A5', 'Jupyter Notebook': '#DA5B0B', PHP: '#4F5D95', Java: '#B07219', C: '#555555', R: '#198CE7', 'C#': '#178600', CSS: '#663399', HTML: '#E34C26', JavaScript: '#F1E05A', TypeScript: '#3178C6' };
const year = new Date().getFullYear();

// The phone stack draws photos and screenshots on canvases, so it gets optimized URLs, not <img> tags
const phoneImage = async (name: string) => {
  const meta = img(name);
  return meta ? (await getImage({ src: meta, width: Math.min(meta.width, 720), format: 'webp' })).src : '';
};
const timeline = buildTimeline(resume, new Date());
// Filled in with the built chunk's URL by the lazy-entry integration (astro.config.mjs)
const phoneEntry = import.meta.env.DEV ? '/src/scripts/phone-stack/entry.ts' : '/__PHONE_STACK_ENTRY__';
const phoneData = {
  roles: await Promise.all(timeline.roles.map(async (r) => ({ ...r, image: await phoneImage(r.image) }))),
  projects: await Promise.all(timeline.projects.map(async (p) => ({ ...p, image: await phoneImage(p.image) }))),
};
---
<Base title={`${b.name} | ${b.label} (Swift, SwiftUI, UIKit)`} description={`${b.name} is a ${b.location.city}-based ${b.label} at ${current?.name}. Top Rated freelancer building polished native apps in Swift, SwiftUI and UIKit. ${b.availability}.`}>
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>

<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="#top" aria-label="uf, Usama Fouad, home">uf</a>
    <nav aria-label="Primary">
      <a href="#work">Work</a><a href="#experience">Experience</a><a href="#activities">Activities</a><a href="#skills">Skills</a><a href="#contact">Contact</a>
    </nav>
    <a class="btn sm primary" href="/cv/">Resume</a>
    <button id="theme" class="icon-btn" type="button" aria-label="Toggle light and dark theme">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<main id="main">
<section class="hero wrap" id="top" aria-labelledby="h1">
  <div>
    <div class="who">
      {avatar && <span class="avatar"><Image src={avatar} alt={b.name} width={128} height={128} loading="eager" /></span>}
      <div><b>{b.name}</b><span class="status">{b.availability} · {b.location.city}</span></div>
    </div>
    <h1 id="h1" set:html={b.headline.replace('polished', '<em class="grad" style="font-style:normal">polished</em>')} />
    <p class="lead">{b.label} working in Swift, SwiftUI and UIKit. By day I build at <strong>{current?.name}</strong>. On the side I'm a <strong>Top Rated</strong> Upwork freelancer, growing into a Senior iOS role.</p>
    <div class="cta">
      <a class="btn primary" href="#contact">Hire me</a>
      <a class="btn" href="#work">See my work</a>
      <a class="btn ghost" href="/cv.pdf" download>Download CV</a>
    </div>
  </div>
  <div class="stage" aria-hidden="true">
    <div class="phone"><div class="screen">
      {heroShots.map((s, i) => <Image src={s} alt="" widths={[250, 380, 500, 640]} sizes="(max-width: 640px) 210px, 250px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
    </div></div>
    <span class="badge a">SwiftUI</span><span class="badge b">AVFoundation</span><span class="badge c">WidgetKit</span>
  </div>
  <dl class="stats">
    {resume.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
  </dl>
</section>

<div class="marquee" aria-hidden="true"><div class="track">
  {[...tech, ...tech].map((t) => <span>{t}</span>)}
</div></div>

<section class="wrap section" id="about" aria-labelledby="t-about">
  <span class="kicker">01 / About</span>
  <h2 class="sec-title" id="t-about">Native craft, engineering depth.</h2>
  <div class="bento" style="margin-top:28px">
    <div class="tile big surface reveal"><p>{b.summary}</p><p>I've worked with AVFoundation, WebKit, WidgetKit, SpriteKit, Core Data, Realm, Firebase, REST, WebSockets, Apple Pay and push notifications, and I understand the systems behind an app: authentication, databases, cloud services and third-party SDKs.</p></div>
    <div class="tile sm surface reveal"><span class="label">Now</span><p class="v">Reading <em>Clean Architecture</em> and extending into React Native.</p></div>
    {resume.education.map((e) => <div class="tile third surface reveal"><span class="label">Education</span><p class="v">{e.studyType}, {e.institution}</p><p>{range(e.startDate, e.endDate)}</p></div>)}
    <div class="tile third surface reveal"><span class="label">Languages</span><p class="v">{resume.languages.map((l) => `${l.language} (${l.fluency.toLowerCase()})`).join(', ')}</p></div>
    <div class="tile third surface reveal"><span class="label">Outside code</span><p class="v">{resume.interests.map((i) => i.name).join(', ')}</p></div>
  </div>
</section>

<section class="wrap section" id="work" aria-labelledby="t-work">
  <span class="kicker">02 / Selected work</span>
  <div class="head-row">
    <div><h2 class="sec-title" id="t-work">Things I've built.</h2>
    <p class="sec-sub">Open-source and personal projects. Client work for {current?.name} and freelance clients is under NDA, and I'm happy to walk through it on a call.</p></div>
  </div>
  <div class="feat">
    {featured.slice(0, 1).map((p) => (
      <article class="feat-card surface reveal" id={`project-${p.id}`} style={`--c:${p.color}`}>
        <div>
          <div class="tags">{p.keywords.map((k) => <span class="chip">{k}</span>)}</div>
          <h3>{p.name}</h3><p>{p.description}</p>
          {p.highlights.length > 0 && <ul>{p.highlights.map((h) => <li>{h}</li>)}</ul>}
          <div class="links" style="margin-top:16px"><a href={p.url} target="_blank" rel="noopener" aria-label={`Code for ${p.name} on GitHub`}>Code ↗</a>{p.demo && <a href={p.demo} target="_blank" rel="noopener" aria-label={`Demo of ${p.name}`}>Demo ↗</a>}</div>
        </div>
        {img(p.image) && <div class="mini-phone"><Image src={img(p.image)!} alt={`${p.name} screenshot`} widths={[200, 400]} sizes="200px" /></div>}
      </article>
    ))}
    <div class="feat-grid">
      {featured.slice(1).map((p) => (
        <article class="feat-card surface reveal" id={`project-${p.id}`} style={`--c:${p.color}`}>
          <div>
            <div class="tags">{p.keywords.map((k) => <span class="chip">{k}</span>)}</div>
            <h3>{p.name}</h3><p>{p.description}</p>
            <div class="links" style="margin-top:14px"><a href={p.url} target="_blank" rel="noopener" aria-label={`Code for ${p.name} on GitHub`}>Code ↗</a>{p.demo && <a href={p.demo} target="_blank" rel="noopener" aria-label={`Demo of ${p.name}`}>Demo ↗</a>}</div>
          </div>
          {img(p.image) && <div class="mini-phone"><Image src={img(p.image)!} alt={`${p.name} screenshot`} widths={[150, 300]} sizes="150px" /></div>}
        </article>
      ))}
    </div>
  </div>
  {clientWork.length > 0 && (
    <>
      <h3 class="sub-title">Client work <span>Private projects, described without client details</span></h3>
      <div class="grid">
        {clientWork.map((p) => (
          <article class="card surface reveal" id={`project-${p.id}`} style={`--c:${p.color}`}>
            <div class="card-top"><span class="swatch" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>{p.period && <span class="period">{fmtDate(p.period)}</span>}</div>
            <h3>{p.name}</h3>{p.at && <span class="at">{p.at}</span>}<p>{p.description}</p>
            {p.reviews.length > 0 && <a class="review-link" href={`#testimonial-${p.reviews[0].id}`}><span aria-hidden="true">★</span> {p.reviews.length === 1 ? 'Client review' : `${p.reviews.length} client reviews`}</a>}
            {p.highlights.length > 0 && <ul class="hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>}
            <div class="tags">{p.keywords.map((k) => <span class="chip">{k}</span>)}</div>
          </article>
        ))}
      </div>
    </>
  )}
  <h3 class="sub-title">More side projects</h3>
  <div class="grid">
    {sideProjects.map((p) => (
      <article class="card surface reveal" id={`project-${p.id}`} style={`--c:${p.color}`}>
        <div class="card-top"><span class="swatch" aria-hidden="true">{p.name[0]}</span>{p.period && <span class="period">{fmtDate(p.period)}</span>}</div>
        <div class="tags">{p.keywords.map((k) => <span class="chip">{k}</span>)}</div>
        <h3>{p.name}</h3><p>{p.description}</p>
        <div class="links">{p.url && <a href={p.url} target="_blank" rel="noopener" aria-label={`Code for ${p.name} on GitHub`}>Code ↗</a>}{p.demo && <a href={p.demo} target="_blank" rel="noopener" aria-label={`Demo of ${p.name}`}>Demo ↗</a>}</div>
      </article>
    ))}
  </div>
  <p class="more"><a href={profile('GitHub')?.url + '?tab=repositories'} target="_blank" rel="noopener">Browse all repositories on GitHub ↗</a></p>
</section>

{resume.testimonials.length > 0 && (
<section class="wrap section" id="feedback" aria-labelledby="t-feedback">
  <span class="kicker">03 / Client feedback</span>
  <div class="head-row">
    <div><h2 class="sec-title" id="t-feedback">What clients say.</h2>
    <p class="sec-sub">In their own words, from reviews on long-term projects. Clients stay anonymous.</p></div>
    {profile('Upwork') && <a class="btn" href={profile('Upwork')!.url} target="_blank" rel="noopener">Verify on Upwork ↗</a>}
  </div>
  <div class="carousel reveal" role="region" aria-roledescription="carousel" aria-label="Client reviews">
  <div class="quotes" tabindex="0">
    {resume.testimonials.map((t) => (
      <figure class="quote surface" id={`testimonial-${t.id}`}>
        {t.rating > 0 && <div class="stars" role="img" aria-label={`${t.rating} out of 5 stars`}>{'★'.repeat(t.rating)}<span>{'★'.repeat(5 - t.rating)}</span></div>}
        <blockquote><p>{t.quote}</p></blockquote>
        <figcaption>
          <b>{t.author}</b>
          <span>{[t.context, fmtDate(t.date), t.source !== 'Upwork' || !t.url ? t.source : ''].filter(Boolean).join(' · ')}</span>
          {t.project && <a href={`#project-${t.project}`}>{t.projectName} →</a>}
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="car-nav" hidden>
    <button class="icon-btn car-prev" type="button" aria-label="Previous review" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
    <span class="car-count" aria-live="polite">1 / {resume.testimonials.length}</span>
    <button class="icon-btn car-next" type="button" aria-label="Next review"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
  </div>
  </div>
</section>
)}

{gh && (
<section class="wrap section" id="opensource" aria-labelledby="t-gh">
  <span class="kicker">04 / Open source</span>
  <div class="head-row">
    <div><h2 class="sec-title" id="t-gh">Live from GitHub.</h2>
    <p class="sec-sub">Pulled from the GitHub API and refreshed daily.</p></div>
    <a class="btn" href={profile('GitHub')?.url} target="_blank" rel="noopener">@usamaeltmsah ↗</a>
  </div>
  <div class="gh">
    <div class="gh-stats surface reveal">
      <div class="gh-nums">
        <div><b>{gh.repos}</b><span>public repos</span></div>
        <div><b>{gh.stars}</b><span>GitHub stars</span></div>
        <div><b>{gh.followers}</b><span>followers</span></div>
      </div>
      <div>
        <span class="label">Top languages</span>
        <div class="langbar" role="img" aria-label={gh.languages.map((l) => `${l.name} ${l.pct}%`).join(', ')}>
          {gh.languages.map((l) => <i style={`width:${l.pct}%;background:${langColors[l.name] ?? '#888'}`} />)}
        </div>
        <ul class="legend">{gh.languages.map((l) => <li style={`--c:${langColors[l.name] ?? '#888'}`}>{l.name} {l.pct}%</li>)}</ul>
      </div>
      <span class="live">Last synced {new Date().toISOString().slice(0, 10)}</span>
    </div>
    <div class="repos">
      {gh.recent.map((r) => (
        <a class="repo surface reveal" href={r.url} target="_blank" rel="noopener">
          <b>{r.name}</b>{r.description && <span>{r.description}</span>}<small>{r.language} · updated {r.pushed}</small>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<section class="wrap section" id="experience" aria-labelledby="t-exp">
  <span class="kicker">05 / Experience</span>
  <h2 class="sec-title" id="t-exp">Where I've worked.</h2>
  <p class="sec-sub phones-only">Each role is an iPhone running a small app, newest first. Scroll to deal through them, then tap the screen to switch tabs or open a project.</p>
  <div class="phones phones-only" style={`--n:${phoneData.roles.length}`} data-entry={phoneEntry}>
    <div class="stage"><nav class="rail" aria-label="Jump to a role"></nav></div>
  </div>
  <script type="application/json" id="phone-data" set:html={JSON.stringify(phoneData).replace(/</g, '\\u003c')} />
  <ol class="timeline" style="margin-top:34px">
    {resume.work.map((w) => (
      <li class="reveal">
        <div class="when">{range(w.startDate, w.endDate)}{w.type !== 'Full-time' && <><br>{w.type}</>}</div>
        <div><h3>{w.position} · <span class="org">{w.name}</span></h3><p>{w.summary}</p>{w.highlights.length > 0 && <ul>{w.highlights.map((h) => <li>{h}</li>)}</ul>}
          {(w.projects.length > 0 || w.activities.length > 0) && (
            <p class="related">{[...w.projects.map((x) => ({ ...x, href: `#project-${x.id}` })), ...w.activities.map((x) => ({ ...x, href: `#activity-${x.id}` }))].map((x) => <a href={x.href}>{x.name}</a>)}</p>
          )}
        </div>
      </li>
    ))}
    {resume.education.map((e) => (
      <li class="reveal"><div class="when">{range(e.startDate, e.endDate)}</div><div><h3>{e.studyType} · <span class="org">{e.institution}</span></h3><p>{e.courses.join(', ')}.</p></div></li>
    ))}
  </ol>
</section>

{resume.volunteer.length > 0 && (
<section class="wrap section" id="volunteering" aria-labelledby="t-vol">
  <span class="kicker">06 / Volunteering</span>
  <h2 class="sec-title" id="t-vol">Giving back.</h2>
  <p class="sec-sub">Teaching, organizing and supporting student communities.</p>
  <div class="vols">
    {resume.volunteer.map((v) => (
      <article class="vol surface reveal" id={`volunteering-${v.id}`}>
        {img(v.image) && <Image src={img(v.image)!} alt={`${v.organization} photo`} widths={[360, 720]} sizes="(max-width: 640px) 90vw, 360px" />}
        <div class="vol-body">
          <span class="role">{v.position} · {range(v.startDate, v.endDate)}</span>
          <h3>{v.organization}</h3>
          <p>{v.summary}</p>
          {v.highlights.length > 0 && <ul class="hl">{v.highlights.map((h) => <li>{h}</li>)}</ul>}
        </div>
      </article>
    ))}
  </div>
</section>
)}

<section class="wrap section" id="activities" aria-labelledby="t-act">
  <span class="kicker">07 / Activities</span>
  <h2 class="sec-title" id="t-act">Beyond the day job.</h2>
  <p class="sec-sub">Challenges, communities and side quests that keep me sharp.</p>
  <div class="acts">
    {resume.activities.map((a) => (
      <article class="act surface reveal" id={`activity-${a.id}`}>
        {img(a.image) && <Image src={img(a.image)!} alt={`${a.name} photo`} widths={[340, 640]} sizes="(max-width: 640px) 90vw, 340px" />}
        <span class="role">{a.role}{a.date && ` · ${fmtDate(a.date)}`}</span>
        <h3>{a.name}</h3>{a.at && <span class="at">{a.at}</span>}<p>{a.description}</p>
        {a.url && <a class="tlink" href={a.url} target="_blank" rel="noopener" aria-label={`Learn more about ${a.name}`}>Learn more ↗</a>}
      </article>
    ))}
  </div>
  <div class="certs surface reveal">
    <div><span class="label">Awards</span>
      {resume.awards.map((a) => <p class="cert"><b>{a.title}</b><span>{a.awarder}</span></p>)}
    </div>
    <div><span class="label">Certificates</span>
      <ul>{resume.certificates.map((c) => <li class="cert">{c.url ? <a href={c.url} target="_blank" rel="noopener"><b>{c.name}</b></a> : <b>{c.name}</b>}<span>{c.issuer}{c.date && ` · ${fmtDate(c.date)}`}</span></li>)}</ul>
    </div>
  </div>
</section>

<section class="wrap section" id="skills" aria-labelledby="t-skills">
  <span class="kicker">08 / Skills</span>
  <h2 class="sec-title" id="t-skills">How I work.</h2>
  <p class="sec-sub">The people side matters as much as the code.</p>
  <div class="soft reveal">
    {resume.softSkills.map((s) => <div><h3>{s.name}</h3><p>{s.description}</p></div>)}
  </div>
  <div class="skills" style="margin-top:16px">
    {resume.skills.map((s) => <div class="surface reveal"><span class="label">{s.name}</span><p>{s.keywords.map((k) => <span class="chip">{k}</span>)}</p></div>)}
  </div>
</section>

{feed.length > 0 && (
<section class="wrap section" id="writing" aria-labelledby="t-posts">
  <span class="kicker">09 / Writing & videos</span>
  <h2 class="sec-title" id="t-posts">Latest from dev.to and YouTube.</h2>
  <p class="sec-sub">Synced automatically every day.</p>
  <div class="posts">
    {feed.map((p) => <a class="post surface reveal" href={p.url} target="_blank" rel="noopener"><small>{p.source}{p.date && ` · ${p.date}`}</small><b>{p.title}</b></a>)}
  </div>
</section>
)}

<section class="wrap section" aria-labelledby="t-dl">
  <div class="dl surface reveal">
    <div>
      <span class="kicker">Resume</span>
      <h2 class="sec-title" id="t-dl">Take my CV with you.</h2>
      <p style="color:var(--muted)">Generated from the same data as this site, so it's always up to date. The JSON follows the open <a class="tlink" href="https://jsonresume.org/schema" target="_blank" rel="noopener">JSON Resume</a> schema.</p>
    </div>
    <div class="dl-actions">
      <a class="btn primary" href="/cv.pdf" download="Usama-Fouad-CV.pdf">Download PDF <span aria-hidden="true">↓</span></a>
      <a class="btn" href="/resume.json" download="usama-fouad-resume.json">Download JSON <span aria-hidden="true">↓</span></a>
      <a class="btn ghost" href="/cv/">View printable CV <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="wrap contact reveal" id="contact" aria-labelledby="t-contact">
  <span class="kicker">Contact</span>
  <h2 class="sec-title" id="t-contact">Let's build something great.</h2>
  <p class="big">Have an app to build, an iOS codebase to rescue, or a team that needs a Swift engineer? Send me a note.</p>
  <div class="cta">
    <a class="btn primary" href={`mailto:${b.email}`}>{b.email}</a>
    <button class="btn" id="copy" type="button" data-email={b.email}>Copy email</button>
    <a class="btn ghost" href={profile('Upwork')?.url} target="_blank" rel="noopener">Hire on Upwork ↗</a>
  </div>
  <ul class="socials">
    {b.profiles.map((p) => <li><a href={p.url} target="_blank" rel="noopener me">{p.network}</a></li>)}
  </ul>
</section>
</main>

<footer class="wrap foot">
  <span>© {year} {b.name}</span>
  <span><a href="/cv/">CV</a> · <a href="/resume.json">resume.json</a> · <a href="/llms.txt">llms.txt</a> · <a href="/index.md">Markdown</a></span>
</footer>
<div id="toast" role="status" aria-live="polite"></div>

<script is:inline>
/* Reviews carousel: the row scrolls and snaps natively (swipe, trackpad, keyboard); this adds
   previous/next buttons and the "2 / 6" counter. Without JS it's still a scrollable row. */
(function(){
  var box=document.querySelector('#feedback .carousel');if(!box)return;
  var row=box.querySelector('.quotes'),items=row.children,nav=box.querySelector('.car-nav'),
      prev=nav.querySelector('.car-prev'),next=nav.querySelector('.car-next'),count=nav.querySelector('.car-count');
  if(items.length<2)return;
  var reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function step(){return items[1].offsetLeft-items[0].offsetLeft}
  function index(){return Math.round(row.scrollLeft/step())}
  function update(){
    var max=row.scrollWidth-row.clientWidth,i=Math.min(index(),items.length-1);
    count.textContent=(row.scrollLeft>=max-2?items.length:i+1)+' / '+items.length;
    prev.disabled=row.scrollLeft<=2;next.disabled=row.scrollLeft>=max-2;
  }
  function go(d){row.scrollBy({left:d*step(),behavior:reduced?'auto':'smooth'})}
  prev.addEventListener('click',function(){go(-1)});
  next.addEventListener('click',function(){go(1)});
  row.addEventListener('scroll',update,{passive:true});
  addEventListener('resize',update);
  /* The markup already shows "1 / N" with Previous disabled, so nothing is measured at load */
  nav.hidden=false;
})();
</script>

<script is:inline>
/* Phone stack loader, inline so the page has no script request at load. WebGL support is
   decided now, so the section's height never jumps later; the 3D code loads only near it. */
(function(){
  var section=document.getElementById('experience'),phones=section&&section.querySelector('.phones'),src=phones&&phones.dataset.entry;
  var webgl=false;try{webgl=!!document.createElement('canvas').getContext('webgl2')}catch(e){}
  if(!section||!src||!webgl||!('IntersectionObserver' in window))return;
  section.classList.add('has-phones');
  /* Fetch the bundle once the page is loaded and idle, so it's ready before anyone scrolls there */
  addEventListener('load',function(){
    var c=navigator.connection;if(c&&c.saveData)return;
    (window.requestIdleCallback||function(f){setTimeout(f,2000)})(function(){
      var l=document.createElement('link');l.rel='modulepreload';l.href=src;document.head.appendChild(l);
    },{timeout:5000});
  });
  var io=new IntersectionObserver(function(es){
    if(!es[0].isIntersecting)return;io.disconnect();
    var s=document.createElement('script');s.type='module';s.src=src;
    s.onerror=function(){section.classList.remove('has-phones');console.error('[phone-stack] could not load '+src+'; showing the plain timeline')};
    document.head.appendChild(s);
  },{rootMargin:'1200px 0px'});
  io.observe(section);
})();
</script>

