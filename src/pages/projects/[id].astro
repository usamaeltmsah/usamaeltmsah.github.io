---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getResume, screenshot, SITE } from '../../lib/data';
import { caseStudies, caseStudyPath, neighbours, paragraphs, type CaseStudyProject } from '../../lib/case-study';

export const getStaticPaths = (async () => {
  const list = caseStudies(await getResume());
  return list.map((project, i) => ({ params: { id: project.id }, props: { project, ...neighbours(list, i) } }));
}) satisfies GetStaticPaths;

interface Props { project: CaseStudyProject; prev?: CaseStudyProject; next?: CaseStudyProject }
const { project: p, prev, next } = Astro.props;
const resume = await getResume();
const b = resume.basics;
const cs = p.caseStudy;
const shot = screenshot(p.image);
const gallery = cs.gallery.map((g) => screenshot(g)).filter((g) => g !== undefined);
const path = caseStudyPath(p.id);
const year = new Date().getFullYear();

const sections = [
  { id: 'problem', title: 'The problem', body: paragraphs(cs.problem) },
  { id: 'approach', title: 'My approach', body: paragraphs(cs.approach), list: p.highlights },
  { id: 'challenge', title: 'The tricky part', body: paragraphs(cs.challenge) },
  { id: 'outcome', title: 'The result', body: paragraphs(cs.outcome) },
].filter((s) => s.body.length);

const entity = {
  '@type': 'SoftwareSourceCode', '@id': `${SITE}${path}#project`, name: p.name, description: p.description,
  codeRepository: p.url || undefined, programmingLanguage: 'Swift', runtimePlatform: 'iOS',
  keywords: p.keywords.join(', '), dateCreated: p.period.slice(0, 4) || undefined,
  author: { '@id': `${SITE}/#me` },
};
---
<Base title={`${p.name}: iOS case study | ${b.name}`} description={`How ${b.name} built ${p.name}: ${p.description}`} path={path} pageType="WebPage" ogType="article" entity={entity}>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="/" aria-label="uf, Usama Fouad, home">uf</a>
    <nav aria-label="Primary">
      <a href="/#work">Work</a><a href="/#experience">Experience</a><a href="/#contact">Contact</a>
    </nav>
    <a class="btn sm primary" href="/cv/">Resume</a>
    <button id="theme" class="icon-btn" type="button" aria-label="Toggle light and dark theme">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>

<main id="main" class="wrap cs" style={`--c:${p.color}`}>
  <a class="back tlink" href={`/#project-${p.id}`}>← Back to selected work</a>

  <section class={`cs-hero${shot ? '' : ' no-shot'}`} aria-labelledby="h1">
    <div>
      <span class="kicker">Case study{p.period && ` · ${p.period}`}</span>
      <h1 id="h1">{p.name}</h1>
      <p class="lead">{p.description}</p>
      <dl class="facts">
        <div><dt>Type</dt><dd>{p.at ? `Built ${p.at}` : 'Personal project'}</dd></div>
        {p.period && <div><dt>Year</dt><dd>{p.period}</dd></div>}
        <div><dt>Built with</dt><dd class="tags">{p.keywords.map((k) => <span class="chip">{k}</span>)}</dd></div>
      </dl>
      <div class="cta">
        {p.url && <a class="btn primary" href={p.url} target="_blank" rel="noopener">View the code ↗</a>}
        {p.demo && <a class="btn" href={p.demo} target="_blank" rel="noopener">Watch the demo ↗</a>}
      </div>
    </div>
    {shot && <div class="mini-phone"><Image src={shot} alt={`${p.name} screenshot`} widths={[260, 520]} sizes="260px" loading="eager" fetchpriority="high" /></div>}
  </section>

  <article class="cs-body">
    {sections.map((s, i) => (
      <section aria-labelledby={`t-${s.id}`}>
        <span class="kicker">0{i + 1}</span>
        <h2 id={`t-${s.id}`}>{s.title}</h2>
        {s.body.map((para) => <p>{para}</p>)}
        {s.list && s.list.length > 0 && <ul>{s.list.map((h) => <li>{h}</li>)}</ul>}
      </section>
    ))}
  </article>

  {gallery.length > 0 && (
    <section class="cs-gallery" aria-labelledby="t-screens">
      <h2 id="t-screens">More screens</h2>
      <div class="shots">
        {gallery.map((g, i) => <Image src={g} alt={`${p.name} screen ${i + 2}`} widths={[240, 480]} sizes="240px" />)}
      </div>
    </section>
  )}

  <aside class="cs-end surface" aria-label="What next">
    <div>
      <h2>Need an app built like this?</h2>
      <p>I'm a {b.label} working in Swift, SwiftUI and UIKit. {b.availability}.</p>
      <div class="cta"><a class="btn primary" href="/#contact">Hire me</a><a class="btn" href="/cv/">Read my CV</a></div>
    </div>
    {(prev || next) && (
      <nav class="pager" aria-label="More case studies">
        {prev && <a href={caseStudyPath(prev.id)}><span>Previous</span>{prev.name}</a>}
        {next && <a href={caseStudyPath(next.id)}><span>Next</span>{next.name}</a>}
      </nav>
    )}
  </aside>
</main>

<footer class="wrap foot">
  <span>© {year} {b.name}</span>
  <span><a href="/">Portfolio</a> · <a href="/cv/">CV</a> · <a href="/resume.json">resume.json</a></span>
</footer>

<script is:inline>
document.getElementById('theme').addEventListener('click',function(){
  var root=document.documentElement,dark=root.dataset.theme?root.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches,n=dark?'light':'dark';
  root.dataset.theme=n;try{localStorage.setItem('theme',n)}catch(e){}
});
</script>
</Base>

<style>
.cs{padding-bottom:24px}
.back{display:inline-block;margin:28px 0 8px;font-size:15px;font-weight:600}
.cs-hero{display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:center;padding:24px 0 56px;position:relative}
.cs-hero.no-shot{grid-template-columns:1fr}
.cs-hero::before{content:"";position:absolute;right:-120px;top:-60px;width:520px;height:520px;border-radius:50%;background:radial-gradient(closest-side,color-mix(in srgb,var(--c) 30%,transparent),transparent);pointer-events:none;z-index:-1}
.cs-hero .lead{margin-top:18px}
.cs-hero .mini-phone{width:260px}
.facts{display:grid;grid-template-columns:auto 1fr;gap:10px 24px;margin-top:28px;max-width:36em}
.facts div{display:contents}
.facts dt{font:600 12px var(--mono);text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding-top:4px}
.facts dd{margin:0}
.cs-body{max-width:720px;border-top:1px solid var(--line)}
.cs-body section{padding:40px 0 4px}
.cs-body h2,.cs-gallery h2{font:800 clamp(26px,3.4vw,34px)/1.15 var(--display);letter-spacing:-.03em;margin-bottom:14px}
.cs-body p{color:var(--muted);font-size:18px}
.cs-body p+p{margin-top:14px}
.cs-body ul{margin:16px 0 0;padding-left:20px;color:var(--muted)}
.cs-body li+li{margin-top:6px}
.cs-gallery{padding-top:56px}
.shots{display:grid;grid-auto-flow:column;grid-auto-columns:220px;gap:20px;overflow-x:auto;padding:8px 2px 18px;scroll-snap-type:x mandatory}
.shots img{width:100%;height:auto;border-radius:24px;border:1px solid var(--line);scroll-snap-align:start;background:#000}
.cs-end{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;margin-top:64px;padding:32px}
.cs-end h2{font:800 28px/1.15 var(--display);letter-spacing:-.03em}
.cs-end p{color:var(--muted);margin-top:8px}
.cs-end .cta{margin-top:20px}
.pager{display:grid;gap:12px;min-width:220px}
.pager a{display:block;padding:14px 18px;border:1px solid var(--line);border-radius:14px;text-decoration:none;font-weight:700;transition:border-color .2s}
.pager a:hover{border-color:var(--accent)}
.pager span{display:block;font:500 12px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
@media (max-width:820px){
  .cs-hero{grid-template-columns:1fr;gap:36px;padding-bottom:40px}
  .cs-hero .mini-phone{width:220px;justify-self:center}
  .cs-end{grid-template-columns:1fr;padding:24px}
}
</style>
